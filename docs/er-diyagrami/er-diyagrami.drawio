to;html=1;startArrow=ERmandOne;endArrow=ERzeroToMany;startFill=0;endFill=0;fontSize=10;fontColor=#000000;labelBackgroundColor=#ffffff;strokeColor=#000000;" parent="1" edge="1" source="e355" target="e322"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="x389" value="onaylar" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;startArrow=ERzeroToOne;endArrow=ERzeroToMany;startFill=0;endFill=0;fontSize=10;fontColor=#000000;labelBackgroundColor=#ffffff;strokeColor=#000000;" parent="1" edge="1" source="e355" target="e111"><mxGeometry as="geometry" relative="1" /></mxCell></root></mxGraphModel></diagram><diagram id="ui" name="Arayüz Sayfaları"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="3400" pageHeight="1400" math="0" shadow="0" background="#ffffff"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="t390" value="Arayüz Sayfaları — Site Haritası" style="text;html=1;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;fontColor=#000000;fontSize=24;fontStyle=1;" parent="1" vertex="1"><mxGeometry as="geometry" x="40" y="20" width="900" height="40" /></mxCell><mxCell id="p391" value="&lt;b&gt;1. Giriş&lt;/b&gt;&lt;br&gt;E-posta + şifre · role göre yönlendirme" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;fontSize=12;fontSize=13;" parent="1" vertex="1"><mxGeometry as="geometry" x="640" y="80" width="320" height="60" /></mxCell><mxCell id="g392" value="İzleme" style="swimlane;startSize=34;html=1;fontStyle=1;fontSize=15;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;swimlaneFillColor=#ffffff;rounded=1;" parent="1" vertex="1"><mxGeometry as="geometry" x="40" y="200" width="500" height="440" /></mxCell><mxCell id="p393" value="&lt;b&gt;2. Canlı Hat&lt;/b&gt;&lt;br&gt;&lt;i&gt;Operatör, amir, yönetici&lt;/i&gt;&lt;br&gt;Makine kartları (5 durum), anlık OEE, kayıp sayacı, son veri zamanı" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;fontSize=12;align=left;spacingLeft=10;spacingRight=10;" parent="g392" vertex="1"><mxGeometry as="geometry" x="20" y="50" width="460" height="110" /></mxCell><mxCell id="p394" value="&lt;b&gt;3. Makine Detayı&lt;/b&gt;&lt;br&gt;&lt;i&gt;Tüm roller&lt;/i&gt;&lt;br&gt;Süre grafiği, baseline, &quot;Neden sarı?&quot;, güven skoru, kalibrasyon başlat" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;fontSize=12;align=left;spacingLeft=10;spacingRight=10;" parent="g392" vertex="1"><mxGeometry as="geometry" x="20" y="180" width="460" height="110" /></mxCell><mxCell id="p395" value="&lt;b&gt;4. Uyarılar&lt;/b&gt;&lt;br&gt;&lt;i&gt;Operatör, amir&lt;/i&gt;&lt;br&gt;Açık/kapalı uyarılar, Üstlendim, kapanışta gerçek sebep seçimi" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;fontSize=12;align=left;spacingLeft=10;spacingRight=10;" parent="g392" vertex="1"><mxGeometry as="geometry" x="20" y="310" width="460" height="110" /></mxCell><mxCell id="x396" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#000000;" parent="1" edge="1" source="p391" target="g392"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="g397" value="Analiz ve karar" style="swimlane;startSize=34;html=1;fontStyle=1;fontSize=15;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;swimlaneFillColor=#ffffff;rounded=1;" parent="1" vertex="1"><mxGeometry as="geometry" x="580" y="200" width="500" height="440" /></mxCell><mxCell id="p398" value="&lt;b&gt;5. Verimlilik ve Kayıp&lt;/b&gt;&lt;br&gt;&lt;i&gt;Amir, yönetici&lt;/i&gt;&lt;br&gt;OEE kırılımı (makine/vardiya/gün), TL kayıp dağılımı, önlenen kayıp" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;fontSize=12;align=left;spacingLeft=10;spacingRight=10;" parent="g397" vertex="1"><mxGeometry as="geometry" x="20" y="50" width="460" height="110" /></mxCell><mxCell id="p399" value="&lt;b&gt;6. Siparişler&lt;/b&gt;&lt;br&gt;&lt;i&gt;Yönetici, amir&lt;/i&gt;&lt;br&gt;Sipariş listesi, tahmini bitiş, risk altındakiler işaretli" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;fontSize=12;align=left;spacingLeft=10;spacingRight=10;" parent="g397" vertex="1"><mxGeometry as="geometry" x="20" y="180" width="460" height="110" /></mxCell><mxCell id="p400" value="&lt;b&gt;7. Senaryo Laboratuvarı&lt;/b&gt;&lt;br&gt;&lt;i&gt;Amir&lt;/i&gt;&lt;br&gt;Seçenek karşılaştırması (OEE, TL, teslim), kırılma noktası grafiği" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;fontSize=12;align=left;spacingLeft=10;spacingRight=10;" parent="g397" vertex="1"><mxGeometry as="geometry" x="20" y="310" width="460" height="110" /></mxCell><mxCell id="x401" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#000000;" parent="1" edge="1" source="p391" target="g397"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="g402" value="İş ve yönetim" style="swimlane;startSize=34;html=1;fontStyle=1;fontSize=15;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;swimlaneFillColor=#ffffff;rounded=1;" parent="1" vertex="1"><mxGeometry as="geometry" x="1120" y="200" width="500" height="440" /></mxCell><mxCell id="p403" value="&lt;b&gt;8. Bakım İş Emirleri&lt;/b&gt;&lt;br&gt;&lt;i&gt;Bakımcı, amir&lt;/i&gt;&lt;br&gt;Atanan işler, makine bakımı / sensör kontrolü, öncesi-sonrası sonuç" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;fontSize=12;align=left;spacingLeft=10;spacingRight=10;" parent="g402" vertex="1"><mxGeometry as="geometry" x="20" y="50" width="460" height="110" /></mxCell><mxCell id="p404" value="&lt;b&gt;9. Ayarlar&lt;/b&gt;&lt;br&gt;&lt;i&gt;Yönetici&lt;/i&gt;&lt;br&gt;Makineler ve maliyet parametreleri, kullanıcılar, planlı duruşlar" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;fontSize=12;align=left;spacingLeft=10;spacingRight=10;" parent="g402" vertex="1"><mxGeometry as="geometry" x="20" y="180" width="460" height="110" /></mxCell><mxCell id="p405" value="&lt;b&gt;10. Demo Paneli&lt;/b&gt;&lt;br&gt;&lt;i&gt;Sunum (gizli)&lt;/i&gt;&lt;br&gt;Senaryo düğmeleri (yavaşlama, ağ gecikmesi, sensör hatası...), x1/x10/x60" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;fontSize=12;align=left;spacingLeft=10;spacingRight=10;" parent="g402" vertex="1"><mxGeometry as="geometry" x="20" y="310" width="460" height="110" /></mxCell><mxCell id="x406" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#000000;" parent="1" edge="1" source="p391" target="g402"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="x407" value="karta tıkla" style="edgeStyle=orthogonalEdgeStyle;curved=1;html=1;endArrow=block;endFill=1;dashed=1;strokeColor=#000000;fontColor=#000000;fontSize=10;labelBackgroundColor=#ffffff;" parent="1" edge="1" source="p393" target="p394"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="x408" value="senaryoyu aç" style="edgeStyle=orthogonalEdgeStyle;curved=1;html=1;endArrow=block;endFill=1;dashed=1;strokeColor=#000000;fontColor=#000000;fontSize=10;labelBackgroundColor=#ffffff;" parent="1" edge="1" source="p395" target="p400"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="x409" value="seçimi onayla → iş emri" style="edgeStyle=orthogonalEdgeStyle;curved=1;html=1;endArrow=block;endFill=1;dashed=1;strokeColor=#000000;fontColor=#000000;fontSize=10;labelBackgroundColor=#ffffff;" parent="1" edge="1" source="p400" target="p403"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="t410" value="Kesikli oklar: sayfalar arası tipik geçişler" style="text;html=1;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;fontColor=#000000;fontSize=12;" parent="1" vertex="1"><mxGeometry as="geometry" x="40" y="660" width="500" height="30" /></mxCell></root></mxGraphModel></diagram></mxfile>